    "%@ is not signed in on your Mac. Run it once in Terminal there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf deinem Mac nicht angemeldet. Starte es dort einmal im Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha iniciado sesión en tu Mac. Ejecútalo una vez allí en Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas connecté sur votre Mac. Lancez-le une fois dans Terminal sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha effettuato l’accesso sul tuo Mac. Avvialo una volta lì nel Terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はMacでサインインしていません。Macのターミナルで一度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 %@에 로그인되어 있지 않습니다. Mac의 터미널에서 한 번 실행하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem sessão iniciada no seu Mac. Execute-o uma vez no Terminal do Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde oturum açmamış. Orada Terminal'de bir kez çalıştırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未在你的 Mac 上登录。请在 Mac 的“终端”中运行一次。"
          }
        }
      }
    },
    "%@ moved to the Trash.": {
