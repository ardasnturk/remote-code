    "%lld items were skipped because they are in use or protected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekte wurden übersprungen, weil sie verwendet werden oder geschützt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron %lld elementos porque están en uso o protegidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments ont été ignorés car ils sont utilisés ou protégés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementi sono stati saltati perché in uso o protetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中または保護されているため、%lld 項目をスキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중이거나 보호되어 %lld개 항목을 건너뛰었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld itens foram ignorados porque estão em uso ou protegidos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanımda veya korumalı oldukları için %lld öğe atlandı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目正在使用或受保护，已跳过。"
          }
        }
      }
    },
