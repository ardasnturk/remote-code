            "value": "Remote Code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code"
          }
        },
        "pt-BR": {
