    "Open Remote Code on your Mac, choose “Pair New Device…” and point the camera at the QR code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Remote Code auf deinem Mac, wähle „Neues Gerät koppeln …“ und richte die Kamera auf den QR-Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Remote Code en tu Mac, elige “Vincular nuevo dispositivo…” y apunta la cámara al código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Remote Code sur votre Mac, choisissez “Jumeler un nouvel appareil…” et pointez l’appareil photo vers le code QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Remote Code sul tuo Mac, scegli “Abbina nuovo dispositivo…” e inquadra il codice QR con la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacでRemote Codeを開いて「新しいデバイスをペアリング…」を選択し、カメラをQRコードに向けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Remote Code를 열고 ‘새로운 기기 페어링…’을 선택한 다음 카메라를 QR 코드에 대십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Remote Code no seu Mac, escolha “Emparelhar Novo Dispositivo…” e aponte a câmera para o código QR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde Remote Code'u açın, “Yeni Cihaz Eşleştir…”i seçin ve kamerayı QR koda tutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开 Remote Code，选择“配对新设备…”，然后将相机对准二维码。"
          }
        }
      }
    },
