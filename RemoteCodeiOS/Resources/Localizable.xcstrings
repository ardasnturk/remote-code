    "Your Mac is running out of space. Agents may fail to build or save files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Mac wird der Platz knapp. Agents können dann eventuell nicht bauen oder Dateien sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac se está quedando sin espacio. Es posible que los agentes no puedan compilar ni guardar archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac manque d’espace. Les agents risquent de ne pas pouvoir compiler ni enregistrer de fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac sta esaurendo lo spazio. Gli agenti potrebbero non riuscire a compilare o salvare file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の空き容量が少なくなっています。エージェントがビルドやファイルの保存に失敗する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 공간이 부족합니다. 에이전트가 빌드하거나 파일을 저장하지 못할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac está ficando sem espaço. Os agentes podem não conseguir compilar ou salvar arquivos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde yer azalıyor. Ajanlar derleme yapamayabilir veya dosya kaydedemeyebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 空间即将用完。代理可能无法构建或保存文件。"
          }
        }
      }
    },
    "Your Mac is summarising the week…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac fasst die Woche zusammen …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac está resumiendo la semana…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac résume la semaine…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Mac sta riepilogando la settimana…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
