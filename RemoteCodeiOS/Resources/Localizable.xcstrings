    "At home, Remote Code talks to your Mac over Wi-Fi. To reach it from anywhere, both devices join your private Tailscale network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Hause spricht Remote Code über WLAN mit deinem Mac. Um ihn überall zu erreichen, treten beide Geräte deinem privaten Tailscale-Netzwerk bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En casa, Remote Code se comunica con tu Mac por Wi-Fi. Para acceder desde cualquier lugar, ambos dispositivos se unen a tu red privada de Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la maison, Remote Code communique avec votre Mac via le Wi-Fi. Pour y accéder de partout, les deux appareils rejoignent votre réseau Tailscale privé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa, Remote Code comunica con il tuo Mac tramite Wi-Fi. Per raggiungerlo ovunque, entrambi i dispositivi si uniscono alla tua rete Tailscale privata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅では、Remote CodeはWi-Fi経由でMacと通信します。どこからでもアクセスするには、両方のデバイスをプライベートなTailscaleネットワークに参加させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집에서는 Remote Code가 Wi-Fi를 통해 Mac과 통신합니다. 어디서나 연결하려면 두 기기 모두 개인 Tailscale 네트워크에 참여해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em casa, o Remote Code fala com o seu Mac pela rede Wi-Fi. Para acessá-lo de qualquer lugar, os dois dispositivos entram na sua rede privada do Tailscale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde Remote Code, Mac'inizle Wi-Fi üzerinden konuşur. Her yerden erişmek için iki cihaz da özel Tailscale ağınıza katılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家时，Remote Code 通过无线局域网与你的 Mac 通信。若要随时随地连接，两台设备都需加入你的私有 Tailscale 网络。"
          }
        }
      }
    },
    "Attach photos or videos": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos oder Videos anhängen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjuntar fotos o vídeos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joindre des photos ou des vidéos"
          }
        },
        "it": {
