    "This post uses photos edited with AI. Add a note to the caption, or turn on the AI label when you post from Instagram.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Beitrag verwendet mit KI bearbeitete Fotos. Füge der Bildunterschrift einen Hinweis hinzu oder aktiviere beim Posten in Instagram die KI-Kennzeichnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta publicación usa fotos editadas con IA. Añade una nota a la descripción o activa la etiqueta de IA al publicar desde Instagram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette publication utilise des photos retouchées par IA. Ajoutez une mention à la légende ou activez l’étiquette IA en publiant depuis Instagram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo post usa foto modificate con l’IA. Aggiungi una nota alla didascalia o attiva l’etichetta IA quando pubblichi da Instagram."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この投稿には AI で編集した写真が使われています。キャプションに注記を追加するか、Instagram から投稿するときに AI ラベルをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게시물에는 AI로 편집한 사진이 사용됩니다. 캡션에 안내를 추가하거나 Instagram에서 게시할 때 AI 라벨을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este post usa fotos editadas com IA. Adicione uma nota à legenda ou ative o rótulo de IA ao publicar pelo Instagram."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gönderi yapay zekâ ile düzenlenmiş fotoğraflar kullanıyor. Açıklamaya bir not ekleyin ya da Instagram'dan paylaşırken yapay zekâ etiketini açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条帖子使用了经 AI 编辑的照片。请在文案中添加说明，或在 Instagram 发布时开启 AI 标签。"
          }
        }
      }
    },
