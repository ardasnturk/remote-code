    "The transcript is removed from your Mac and this device. Files Claude changed are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf wird von deinem Mac und diesem Gerät entfernt. Von Claude geänderte Dateien bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se elimina de tu Mac y de este dispositivo. Los archivos que cambió Claude no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique est supprimé de votre Mac et de cet appareil. Les fichiers modifiés par Claude ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia viene rimossa dal tuo Mac e da questo dispositivo. I file modificati da Claude non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランスクリプトはMacとこのデバイスから削除されます。Claudeが変更したファイルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 Mac과 이 기기에서 제거됩니다. Claude가 변경한 파일은 영향을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição é removida do seu Mac e deste dispositivo. Os arquivos alterados pelo Claude não são afetados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döküm Mac'inizden ve bu cihazdan silinir. Claude'un değiştirdiği dosyalar etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录将从你的 Mac 和此设备中移除。Claude 更改过的文件不受影响。"
          }
        }
      }
    },
