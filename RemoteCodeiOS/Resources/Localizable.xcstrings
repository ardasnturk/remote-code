    "Scheduled or published posts cannot be revised.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante oder veröffentlichte Beiträge können nicht überarbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones programadas o publicadas no se pueden revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications planifiées ou publiées ne peuvent pas être révisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post pianificati o pubblicati non possono essere modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約済みまたは公開済みの投稿は修正できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약되었거나 게시된 게시물은 수정할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicações agendadas ou publicadas não podem ser revisadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış ya da paylaşılmış gönderiler revize edilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已定时或已发布的帖子无法修改。"
          }
        }
      }
    },
    "Scheduled posts go out while Promo Studio is running on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Beiträge werden gepostet, solange Promo Studio auf deinem Mac läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones programadas se publican mientras Promo Studio se ejecuta en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications planifiées partent tant qu’Promo Studio fonctionne sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I post pianificati vengono pubblicati mentre Promo Studio è in esecuzione sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約投稿はMacでPromo Studioが実行中に投稿されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
