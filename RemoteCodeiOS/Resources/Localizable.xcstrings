    "%@ does not report its commands to Remote Code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ meldet seine Befehle nicht an Remote Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no informa de sus comandos a Remote Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne communique pas ses commandes à Remote Code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non comunica i suoi comandi a Remote Code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はコマンドをRemote Codeに通知しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) Remote Code에 명령을 보고하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não informa seus comandos ao Remote Code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ komutlarını Remote Code'a bildirmiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不会向 Remote Code 报告其命令。"
          }
        }
      }
    },
