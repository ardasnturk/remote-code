    "End-to-end encrypted between your devices. No accounts, no cloud, no tracking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende-zu-Ende verschlüsselt zwischen deinen Geräten. Keine Konten, keine Cloud, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado de extremo a extremo entre tus dispositivos. Sin cuentas, sin nube, sin rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré de bout en bout entre vos appareils. Pas de compte, pas de cloud, pas de suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crittografia end-to-end tra i tuoi dispositivi. Nessun account, nessun cloud, nessun tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス間はエンドツーエンドで暗号化されます。アカウントもクラウドもトラッキングもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 간 종단 간 암호화. 계정도, 클라우드도, 추적도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografia de ponta a ponta entre seus dispositivos. Sem contas, sem nuvem, sem rastreamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazlarınız arasında uçtan uca şifreli. Hesap yok, bulut yok, takip yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备之间端到端加密。无需账户，无云端，无跟踪。"
          }
        }
      }
    },
    "Every action in this chat is now allowed without asking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Chat ist jetzt jede Aktion ohne Nachfrage erlaubt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora todas las acciones de este chat se permiten sin preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les actions de cette discussion sont désormais autorisées sans confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora ogni azione in questa chat è consentita senza chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットのすべての操作が確認なしで許可されるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 이 채팅의 모든 작업이 묻지 않고 허용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora todas as ações nesta conversa são permitidas sem perguntar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbette artık her işleme sormadan izin veriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天中的所有操作现在都无需询问即被允许。"
          }
        }
      }
    },
    "Explore Remote Code with a simulated Mac. Nothing is sent anywhere and no Mac is needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde Remote Code mit einem simulierten Mac. Es wird nichts gesendet und kein Mac benötigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora Remote Code con un Mac simulado. No se envía nada a ningún sitio y no necesitas un Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez Remote Code avec un Mac simulé. Rien n’est envoyé nulle part et aucun Mac n’est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora Remote Code con un Mac simulato. Non viene inviato nulla e non serve un Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレートしたMacでRemote Codeを試せます。何も送信されず、Macも必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이션된 Mac으로 Remote Code를 살펴보십시오. 어떤 데이터도 전송되지 않으며 Mac이 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore o Remote Code com um Mac simulado. Nada é enviado para lugar nenhum e nenhum Mac é necessário."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code'u simüle edilmiş bir Mac ile keşfedin. Hiçbir yere bir şey gönderilmez ve Mac gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过模拟的 Mac 探索 Remote Code。不会发送任何内容，也不需要 Mac。"
          }
        }
      }
    },
