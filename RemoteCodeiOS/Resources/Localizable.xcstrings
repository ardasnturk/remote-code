    "Move to Trash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb legen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasladar a la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer dans la Corbeille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta nel Cestino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover para o Lixo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu'na Taşı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓"
          }
        }
      }
    },
    "Moving to the Trash frees the space only after the Trash is emptied. Items in the Trash itself are always deleted permanently.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Verschieben in den Papierkorb wird Platz erst frei, wenn der Papierkorb entleert wird. Objekte im Papierkorb selbst werden immer endgültig gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al trasladar a la Papelera, el espacio se libera solo cuando se vacía la Papelera. Los elementos de la propia Papelera siempre se eliminan definitivamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer dans la Corbeille ne libère l’espace qu’une fois la Corbeille vidée. Les éléments de la Corbeille elle-même sont toujours supprimés définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostando nel Cestino lo spazio si libera solo dopo averlo svuotato. Gli elementi già nel Cestino vengono sempre eliminati definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れた場合、ゴミ箱を空にするまで容量は空きません。ゴミ箱内の項目は常に完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동하면 휴지통을 비운 후에야 공간이 확보됩니다. 휴지통에 있는 항목은 항상 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover para o Lixo libera espaço só depois que o Lixo é esvaziado. Itens que já estão no Lixo são sempre apagados permanentemente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu'na taşımak alanı ancak Çöp Kutusu boşaltıldığında boşaltır. Çöp Kutusu'ndaki öğeler her zaman kalıcı olarak silinir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓后，只有清倒废纸篓才会释放空间。废纸篓中的项目始终会被永久删除。"
          }
        }
      }
    },
