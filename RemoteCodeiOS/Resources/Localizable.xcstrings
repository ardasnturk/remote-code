    "Paused while on battery. It resumes on power.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Akkubetrieb pausiert. Wird am Netzteil fortgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa mientras usa la batería. Se reanuda al conectarlo a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu sur batterie. Reprend sur secteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa a batteria. Riprende con l’alimentazione."
          }
