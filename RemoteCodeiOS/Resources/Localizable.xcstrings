            "value": "Remote Code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code"
          }
        }
      }
    },
    "Remote Code always connects over your Wi-Fi first. Turn this on only if you also use Tailscale, to reach your Mac when you are away from that Wi-Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code verbindet sich immer zuerst über dein WLAN. Aktiviere das nur, wenn du auch Tailscale nutzt, um deinen Mac außerhalb dieses WLANs zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code siempre se conecta primero por tu Wi-Fi. Activa esto solo si también usas Tailscale, para acceder a tu Mac cuando estés lejos de esa Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code se connecte toujours d’abord via votre Wi-Fi. N’activez cette option que si vous utilisez aussi Tailscale, pour joindre votre Mac lorsque vous êtes loin de ce Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code si connette sempre prima tramite la tua rete Wi-Fi. Attiva questa opzione solo se usi anche Tailscale, per raggiungere il tuo Mac quando sei lontano da quella rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Codeは常にまずWi-Fi経由で接続します。そのWi-Fiから離れているときにMacにアクセスするためにTailscaleも使用している場合のみ、オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code는 항상 Wi-Fi를 통해 먼저 연결합니다. Tailscale도 사용하여 해당 Wi-Fi 밖에서 Mac에 연결하려는 경우에만 이 옵션을 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code sempre se conecta primeiro pela sua rede Wi-Fi. Ative esta opção apenas se você também usa o Tailscale, para acessar o seu Mac quando estiver longe dessa rede Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code her zaman önce Wi-Fi'niz üzerinden bağlanır. Bunu yalnızca Tailscale da kullanıyorsanız, o Wi-Fi'den uzaktayken Mac'inize ulaşmak için açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 始终优先通过无线局域网连接。仅当你也使用 Tailscale、需要在离开该无线局域网时连接 Mac 时，才打开此选项。"
          }
        }
      }
    },
    "Remote Code could not access the Keychain: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code konnte nicht auf den Schlüsselbund zugreifen: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code no ha podido acceder al llavero: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code n’a pas pu accéder au trousseau : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code non è riuscito ad accedere al portachiavi: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Codeはキーチェーンにアクセスできませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code가 키체인에 접근할 수 없습니다: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code não conseguiu acessar as Chaves: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code Anahtar Zinciri'ne erişemedi: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 无法访问钥匙串：%@"
          }
        }
      }
    },
    "Remote Code doesn't know your Mac's Tailscale address yet. Connect once over the same Wi-Fi while Tailscale is running on the Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code kennt die Tailscale-Adresse deines Macs noch nicht. Verbinde dich einmal über dasselbe WLAN, während Tailscale auf dem Mac läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code aún no conoce la dirección de Tailscale de tu Mac. Conéctate una vez por la misma red wifi mientras Tailscale está activo en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code ne connaît pas encore l’adresse Tailscale de votre Mac. Connectez-vous une fois via le même Wi-Fi pendant que Tailscale est actif sur le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code non conosce ancora l’indirizzo Tailscale del tuo Mac. Connettiti una volta tramite la stessa rete Wi-Fi mentre Tailscale è attivo sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote CodeはまだMacのTailscaleアドレスを知りません。MacでTailscaleを実行したまま、一度同じWi-Fi経由で接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code가 아직 Mac의 Tailscale 주소를 모릅니다. Mac에서 Tailscale이 실행 중일 때 같은 Wi-Fi로 한 번 연결하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code ainda não sabe o endereço Tailscale do seu Mac. Conecte-se uma vez pela mesma rede Wi-Fi enquanto o Tailscale estiver ativo no Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code, Mac'inizin Tailscale adresini henüz bilmiyor. Mac'te Tailscale çalışırken bir kez aynı Wi-Fi üzerinden bağlanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 尚不知道你的 Mac 的 Tailscale 地址。请在 Mac 上运行 Tailscale 时，通过同一无线局域网连接一次。"
          }
        }
      }
    },
    "Remote Code follows your iPhone's language. To use another one just for Remote Code, choose it in Settings → Apps → Remote Code → Language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code folgt der Sprache deines iPhone. Um nur für Remote Code eine andere zu verwenden, wähle sie unter Einstellungen → Apps → Remote Code → Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code sigue el idioma de tu iPhone. Para usar otro solo en Remote Code, elígelo en Ajustes → Apps → Remote Code → Idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code suit la langue de votre iPhone. Pour en utiliser une autre uniquement dans Remote Code, choisissez-la dans Réglages → Apps → Remote Code → Langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code segue la lingua del tuo iPhone. Per usarne un’altra solo per Remote Code, sceglila in Impostazioni → App → Remote Code → Lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote CodeはiPhoneの言語に従います。Remote Codeだけ別の言語を使用するには、設定 → アプリ → Remote Code → 言語で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code는 iPhone의 언어를 따릅니다. Remote Code에서만 다른 언어를 사용하려면 설정 → 앱 → Remote Code → 언어에서 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code segue o idioma do seu iPhone. Para usar outro idioma apenas no Remote Code, escolha-o em Ajustes → Apps → Remote Code → Idioma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code, iPhone'unuzun dilini kullanır. Yalnızca Remote Code için başka bir dil kullanmak isterseniz Ayarlar → Uygulamalar → Remote Code → Dil bölümünden seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 跟随 iPhone 的语言。若要仅为 Remote Code 使用其他语言，请在“设置”→“App”→ Remote Code →“语言”中选择。"
          }
        }
      }
    },
    "Remote Code is not allowed to use the local network, so it cannot reach your Mac on this Wi-Fi. Turn on Local Network for Remote Code in Settings, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code darf das lokale Netzwerk nicht verwenden und erreicht deinen Mac in diesem WLAN deshalb nicht. Aktiviere „Lokales Netzwerk“ für Remote Code in den Einstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code no tiene permiso para usar la red local, así que no puede acceder a tu Mac en esta Wi-Fi. Activa Red local para Remote Code en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code n’est pas autorisé à utiliser le réseau local et ne peut donc pas joindre votre Mac sur ce Wi-Fi. Activez Réseau local pour Remote Code dans Réglages, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code non è autorizzato a usare la rete locale, quindi non può raggiungere il tuo Mac su questa rete Wi-Fi. Attiva Rete locale per Remote Code in Impostazioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Codeにはローカルネットワークの使用が許可されていないため、このWi-FiでMacに接続できません。設定でRemote Codeのローカルネットワークをオンにしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code에 로컬 네트워크 사용이 허용되지 않아 이 Wi-Fi에서 Mac에 연결할 수 없습니다. 설정에서 Remote Code의 로컬 네트워크를 켠 다음 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code não tem permissão para usar a rede local, então não consegue acessar o seu Mac nesta rede Wi-Fi. Ative Rede Local para o Remote Code em Ajustes e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code'un yerel ağı kullanma izni yok, bu yüzden bu Wi-Fi'de Mac'inize ulaşamıyor. Ayarlar'da Remote Code için Yerel Ağ'ı açıp tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 未被允许使用本地网络，因此无法在此无线局域网中连接你的 Mac。请在“设置”中为 Remote Code 打开“本地网络”，然后重试。"
          }
        }
      }
    },
    "Remote Code learns your Mac's Tailscale address automatically and uses it whenever the local network is not available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code lernt die Tailscale-Adresse deines Macs automatisch und nutzt sie, wenn das lokale Netzwerk nicht verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code obtiene automáticamente la dirección de Tailscale de tu Mac y la usa cuando la red local no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code apprend automatiquement l’adresse Tailscale de votre Mac et l’utilise lorsque le réseau local n’est pas disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code rileva automaticamente l’indirizzo Tailscale del tuo Mac e lo usa quando la rete locale non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote CodeはMacのTailscaleアドレスを自動的に取得し、ローカルネットワークが利用できないときに使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code는 Mac의 Tailscale 주소를 자동으로 파악하고 로컬 네트워크를 사용할 수 없을 때마다 이 주소를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code obtém o endereço do Tailscale do seu Mac automaticamente e o usa sempre que a rede local não estiver disponível."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code, Mac'inizin Tailscale adresini otomatik öğrenir ve yerel ağ kullanılamadığında bu adresi kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 会自动获取你 Mac 的 Tailscale 地址，并在本地网络不可用时使用它。"
          }
        }
      }
    },
    "Remote Code may not use the local network. Turn on Local Network for Remote Code in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code darf das lokale Netzwerk nicht verwenden. Aktiviere „Lokales Netzwerk“ für Remote Code in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code no puede usar la red local. Activa Red local para Remote Code en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code ne peut pas utiliser le réseau local. Activez Réseau local pour Remote Code dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code non può usare la rete locale. Attiva Rete locale per Remote Code in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Codeはローカルネットワークを使用できません。設定でRemote Codeのローカルネットワークをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code가 로컬 네트워크를 사용할 수 없습니다. 설정에서 Remote Code의 로컬 네트워크를 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code não pode usar a rede local. Ative Rede Local para o Remote Code em Ajustes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code'un yerel ağı kullanma izni yok. Ayarlar'da Remote Code için Yerel Ağ'ı açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 无法使用本地网络。请在“设置”中为 Remote Code 打开“本地网络”。"
          }
        }
      }
    },
    "Remote Code uses no third-party libraries. Encryption is provided by Apple CryptoKit and follows the public-domain Noise Protocol Framework specification.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code verwendet keine Bibliotheken von Drittanbietern. Die Verschlüsselung stammt aus Apple CryptoKit und folgt der gemeinfreien Spezifikation des Noise Protocol Framework."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code no usa bibliotecas de terceros. El cifrado lo proporciona Apple CryptoKit y sigue la especificación de dominio público del Noise Protocol Framework."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code n’utilise aucune bibliothèque tierce. Le chiffrement est fourni par Apple CryptoKit et suit la spécification du Noise Protocol Framework, qui relève du domaine public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code non usa librerie di terze parti. La crittografia è fornita da Apple CryptoKit e segue la specifica di pubblico dominio del Noise Protocol Framework."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Codeはサードパーティ製ライブラリを使用していません。暗号化はApple CryptoKitによって提供され、パブリックドメインのNoise Protocol Framework仕様に準拠しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code는 타사 라이브러리를 사용하지 않습니다. 암호화는 Apple CryptoKit으로 제공되며 퍼블릭 도메인인 Noise Protocol Framework 사양을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code não usa bibliotecas de terceiros. A criptografia é fornecida pelo Apple CryptoKit e segue a especificação Noise Protocol Framework, de domínio público."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code üçüncü taraf kütüphane kullanmaz. Şifreleme Apple CryptoKit ile sağlanır ve kamu malı Noise Protocol Framework belirtimini izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 不使用任何第三方库。加密由 Apple CryptoKit 提供，并遵循公有领域的 Noise Protocol Framework 规范。"
          }
        }
      }
    },
    "Remote Code was restarted while Claude was working; the last turn may be incomplete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code wurde neu gestartet, während Claude arbeitete; die letzte Runde ist eventuell unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code se reinició mientras Claude trabajaba; puede que el último turno esté incompleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code a redémarré pendant que Claude travaillait ; le dernier tour est peut-être incomplet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code è stato riavviato mentre Claude lavorava; l’ultimo turno potrebbe essere incompleto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeの作業中にRemote Codeが再起動されました。最後のターンが不完全な可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 작업하는 동안 Remote Code가 재시작되었습니다. 마지막 턴이 완료되지 않았을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code foi reiniciado enquanto o Claude trabalhava; o último turno pode estar incompleto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude çalışırken Remote Code yeniden başlatıldı; son tur eksik olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 工作期间 Remote Code 已重新启动；最后一轮可能不完整。"
          }
        }
      }
    },
    "Remote Code works with Claude Code. It is an independent open-source project and is not affiliated with Anthropic. Remote Code collects no data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code funktioniert mit Claude Code. Es ist ein unabhängiges Open-Source-Projekt und steht in keiner Verbindung zu Anthropic. Remote Code sammelt keine Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code funciona con Claude Code. Es un proyecto independiente de código abierto y no está afiliado a Anthropic. Remote Code no recopila datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code fonctionne avec Claude Code. C’est un projet open source indépendant, sans lien avec Anthropic. Remote Code ne collecte aucune donnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code funziona con Claude Code. È un progetto open source indipendente e non è affiliato ad Anthropic. Remote Code non raccoglie dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote CodeはClaude Codeと連携して動作します。独立したオープンソースプロジェクトであり、Anthropicとは提携していません。Remote Codeはデータを収集しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code는 Claude Code와 함께 작동합니다. 독립적인 오픈 소스 프로젝트이며 Anthropic과 제휴 관계가 없습니다. Remote Code는 데이터를 수집하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Remote Code funciona com o Claude Code. É um projeto independente de código aberto e não é afiliado à Anthropic. O Remote Code não coleta dados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code, Claude Code ile çalışır. Bağımsız, açık kaynaklı bir projedir ve Anthropic ile bağlantılı değildir. Remote Code hiçbir veri toplamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code 与 Claude Code 配合使用。它是一个独立的开源项目，与 Anthropic 无关联。Remote Code 不收集任何数据。"
          }
        }
      }
    },
