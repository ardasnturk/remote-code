            "state": "translated",
            "value": "Allega foto o video"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真またはビデオを添付"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 또는 비디오 첨부"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexar fotos ou vídeos"
          }
        },
        "tr": {
