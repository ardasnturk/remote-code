    "Vitrin builds your App Store listing and runs App Store Connect from a tab here. It downloads about 450 MB to your Mac once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin erstellt Ihren App-Store-Eintrag und führt App Store Connect über einen Tab hier aus. Einmalig werden etwa 450 MB auf Ihren Mac geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin crea tu ficha de la App Store y gestiona App Store Connect desde una pestaña aquí. Descarga unos 450 MB en tu Mac una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin crée votre fiche App Store et gère App Store Connect depuis un onglet ici. Il télécharge environ 450 Mo sur votre Mac une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin crea la tua scheda App Store e gestisce App Store Connect da una scheda qui. Scarica circa 450 MB sul Mac una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin は App Store のページを作成し、ここのタブから App Store Connect を管理します。Mac に一度だけ約 450 MB をダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin은 App Store 페이지를 만들고 여기 탭에서 App Store Connect를 관리합니다. Mac에 약 450MB를 한 번 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vitrin cria sua página na App Store e gerencia o App Store Connect em uma aba aqui. Ele baixa cerca de 450 MB no Mac uma vez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin, App Store sayfanızı hazırlar ve App Store Connect'i buradaki bir sekmeden yönetir. Mac'inize bir kez yaklaşık 450 MB indirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrin 可创建 App Store 页面,并在此处的标签页中管理 App Store Connect。它会向 Mac 下载一次约 450 MB 的内容。"
          }
        }
      }
    },
