    "Choose an account to post, or save the image and post it yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Konto zum Posten oder sichere das Bild und poste es selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una cuenta para publicar, o guarda la imagen y publícala tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un compte pour publier, ou enregistrez l’image et publiez-la vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un account per pubblicare, oppure salva l’immagine e pubblicala tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿するアカウントを選ぶか、画像を保存して自分で投稿してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시할 계정을 선택하거나, 이미지를 저장해 직접 게시하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma conta para publicar ou salve a imagem e publique você mesmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşmak için bir hesap seçin ya da görseli kaydedip kendiniz paylaşın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个账户来发布,或保存图片后自行发布。"
          }
        }
      }
    },
    "Choose an account to post, or save the video and post it yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
