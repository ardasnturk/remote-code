    "A 9:16 image can only be a story; Instagram’s feed allows 4:5 at most.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein 9:16-Bild kann nur eine Story sein; der Instagram-Feed erlaubt höchstens 4:5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen 9:16 solo puede ser una historia; el feed de Instagram permite como máximo 4:5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image 9:16 ne peut être qu’une story ; le fil Instagram accepte au plus 4:5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’immagine 9:16 può essere solo una storia; il feed di Instagram consente al massimo 4:5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9:16の画像はストーリーズにしかできません。Instagramのフィードは最大4:5です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "9:16 이미지는 스토리로만 올릴 수 있습니다. Instagram 피드는 최대 4:5까지 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem 9:16 só pode ser um story; o feed do Instagram permite no máximo 4:5."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "9:16 bir görsel yalnızca hikâye olabilir; Instagram akışı en fazla 4:5'e izin veriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "9:16 的图片只能发为快拍;Instagram 动态最多支持 4:5。"
          }
        }
      }
    },
