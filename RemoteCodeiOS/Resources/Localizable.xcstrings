    "Nothing is made until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis dahin wird nichts erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta entonces no se crea nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est créé d’ici là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino ad allora non viene creato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまで何も作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
