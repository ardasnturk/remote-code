    "Ask %@ anything about this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag %@ alles zu diesem Ordner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a %@ lo que quieras sobre esta carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à %@ tout ce que vous voulez sur ce dossier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a %@ qualsiasi cosa su questa cartella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダについて%@に何でも質問"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 대해 %@에게 무엇이든 물어보십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao %@ qualquer coisa sobre esta pasta"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörle ilgili %@'e istediğini sor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 %@ 询问有关此文件夹的任何问题"
          }
        }
      }
    },
