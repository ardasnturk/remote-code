    "Planned: it posts automatically when it’s ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplant: wird automatisch gepostet, sobald es fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planificado: se publica automáticamente cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifié : publié automatiquement une fois prêt."
          }
        },
