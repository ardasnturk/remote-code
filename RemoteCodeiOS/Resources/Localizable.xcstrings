    "Approve or deny file edits and commands with one tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiänderungen und Befehle mit einem Tippen erlauben oder ablehnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba o rechaza cambios en archivos y comandos con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez ou refusez les modifications de fichiers et les commandes d’un simple toucher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva o rifiuta modifiche ai file e comandi con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの編集やコマンドをワンタップで承認または拒否できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 탭으로 파일 편집과 명령을 승인하거나 거부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove ou negue edições de arquivos e comandos com um toque."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya düzenlemelerini ve komutları tek dokunuşla onaylayın ya da reddedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下即可批准或拒绝文件编辑和命令。"
          }
        }
      }
    },
