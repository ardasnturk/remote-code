    "Claude writes a storyboard, you approve or revise it, then Claude produces the video.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude schreibt ein Storyboard, du gibst es frei oder überarbeitest es, dann produziert Claude das Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude escribe un guion gráfico, tú lo apruebas o lo revisas y luego Claude produce el vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude rédige un storyboard, vous l’approuvez ou le révisez, puis Claude produit la vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude scrive uno storyboard, tu lo approvi o lo modifichi, poi Claude produce il video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeが絵コンテを書き、あなたが承認または修正すると、Claudeが動画を制作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 스토리보드를 작성하고, 승인하거나 수정하면 Claude가 동영상을 제작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude escreve um storyboard, você aprova ou revisa e então o Claude produz o vídeo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude bir storyboard yazar, sen onaylar ya da revize edersin, ardından Claude videoyu üretir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
