    "%@ runs on your Mac. You'll see every step here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft auf deinem Mac. Du siehst hier jeden Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ejecuta en tu Mac. Aquí verás cada paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’exécute sur votre Mac. Vous verrez chaque étape ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene eseguito sul tuo Mac. Qui vedrai ogni passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はMac上で動作します。すべてのステップをここで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) Mac에서 실행됩니다. 모든 단계를 여기에서 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é executado no seu Mac. Você verá cada etapa aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde çalışır. Her adımı burada görürsünüz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在你的 Mac 上运行。你可以在这里看到每一步。"
          }
        }
      }
    },
    "%@ uses %@ of the processor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nutzt %@ des Prozessors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa el %@ del procesador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise %@ du processeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa il %@ del processore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がプロセッサの %@ を使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 프로세서의 %@를 사용 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa %@ do processador."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ işlemcinin %@ kadarını kullanıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 占用了 %@ 的处理器。"
          }
        }
      }
    },
    "%@ uses the most (%@). Quitting it frees memory right away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belegt am meisten (%@). Beendest du es, wird sofort Speicher frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es la que más usa (%@). Al salir de ella se libera memoria de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en utilise le plus (%@). Le quitter libère aussitôt de la mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne usa di più (%@). Chiudendola la memoria si libera subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も多く使っているのは %@（%@）です。終了するとすぐにメモリが空きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 가장 많이 사용 중입니다(%@). 종료하면 즉시 메모리가 확보됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é o que mais usa (%@). Encerrá-lo libera memória na hora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok %@ kullanıyor (%@). Kapatırsanız bellek hemen boşalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 占用最多（%@）。退出它可立即释放内存。"
          }
        }
      }
    },
