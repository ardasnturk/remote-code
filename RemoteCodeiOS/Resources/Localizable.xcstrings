            "value": "オン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
