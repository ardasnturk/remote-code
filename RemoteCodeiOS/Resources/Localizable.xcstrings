    "File edits are applied automatically; commands still need approval.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiänderungen werden automatisch übernommen; Befehle brauchen weiterhin eine Freigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en archivos se aplican automáticamente; los comandos siguen necesitando aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de fichiers sont appliquées automatiquement ; les commandes doivent toujours être approuvées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche ai file vengono applicate automaticamente; i comandi richiedono ancora l’approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの編集は自動的に適用されます。コマンドには引き続き承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 편집은 자동으로 적용되며, 명령은 여전히 승인이 필요합니다."
          }
        },
        "pt-BR": {
