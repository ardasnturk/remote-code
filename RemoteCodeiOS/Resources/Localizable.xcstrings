    "On the Mac, click the >_ icon, choose “Pair iPhone or iPad…”, then tap the button below and scan the code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf dem Mac auf das >_-Symbol, wähle „iPhone oder iPad koppeln …“, tippe dann unten auf die Taste und scanne den Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Mac, haz clic en el icono >_, elige “Vincular iPhone o iPad…”, toca el botón de abajo y escanea el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le Mac, cliquez sur l’icône >_, choisissez “Jumeler un iPhone ou iPad…”, puis touchez le bouton ci-dessous et scannez le code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul Mac, fai clic sull’icona >_, scegli “Abbina iPhone o iPad…”, poi tocca il pulsante qui sotto e scansiona il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで「>_」アイコンをクリックして「iPhoneまたはiPadをペアリング…」を選択し、下のボタンをタップしてコードをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 >_ 아이콘을 클릭하고 ‘iPhone 또는 iPad 페어링…’을 선택한 다음, 아래 버튼을 탭하고 코드를 스캔하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac, clique no ícone >_, escolha “Emparelhar iPhone ou iPad…”, depois toque no botão abaixo e escaneie o código."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te >_ simgesine tıklayın, “iPhone veya iPad Eşleştir…” öğesini seçin, ardından aşağıdaki düğmeye dokunup kodu tarayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上点按 >_ 图标，选择“配对 iPhone 或 iPad…”，然后轻点下方按钮并扫描代码。"
          }
        }
      }
    },
    "On this device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät"
          }
