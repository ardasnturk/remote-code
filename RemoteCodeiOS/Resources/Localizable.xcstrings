    "Free space, memory and CPU of your Mac. Clean up caches or quit an app that slows it down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freier Speicherplatz, Arbeitsspeicher und CPU deines Macs. Bereinige Caches oder beende eine App, die ihn bremst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio libre, memoria y CPU de tu Mac. Limpia cachés o cierra una app que lo ralentice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libre, mémoire et processeur de votre Mac. Nettoyez les caches ou quittez une app qui le ralentit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero, memoria e CPU del Mac. Pulisci le cache o chiudi un’app che lo rallenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の空き容量、メモリ、CPU。キャッシュを削除したり、Mac を遅くしているアプリを終了したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 여유 공간, 메모리 및 CPU. 캐시를 정리하거나 Mac을 느리게 하는 앱을 종료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre, memória e CPU do Mac. Limpe caches ou encerre um app que o deixa lento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizin boş alanı, belleği ve işlemcisi. Önbellekleri temizleyin veya Mac'i yavaşlatan bir uygulamayı kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 的可用空间、内存和 CPU。清理缓存，或退出拖慢 Mac 的 App。"
          }
        }
      }
    },
