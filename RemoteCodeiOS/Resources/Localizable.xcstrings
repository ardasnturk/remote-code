    "After linking a new Instagram account to one of your Facebook Pages, refresh to add it without signing in again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem du ein neues Instagram-Konto mit einer deiner Facebook-Seiten verknüpft hast, aktualisiere, um es ohne erneute Anmeldung hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de vincular una nueva cuenta de Instagram a una de tus páginas de Facebook, actualiza para añadirla sin volver a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir lié un nouveau compte Instagram à l’une de vos pages Facebook, actualisez pour l’ajouter sans vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver collegato un nuovo account Instagram a una delle tue pagine Facebook, aggiorna per aggiungerlo senza accedere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいInstagramアカウントをFacebookページにリンクしたら、更新すると再ログインせずに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 Instagram 계정을 Facebook 페이지에 연결한 후 새로고침하면 다시 로그인하지 않고 추가할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de vincular uma nova conta do Instagram a uma das suas Páginas do Facebook, atualize para adicioná-la sem entrar novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facebook Sayfalarından birine yeni bir Instagram hesabı bağladıktan sonra, yeniden giriş yapmadan eklemek için yenile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将新的 Instagram 账户关联到你的某个 Facebook 主页后，刷新即可添加，无需重新登录。"
          }
        }
      }
    },
