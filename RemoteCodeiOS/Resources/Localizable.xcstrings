    "Remote Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code"
          }
        },
        "fr": {
