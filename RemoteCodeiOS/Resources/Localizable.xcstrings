    "Update Promo Studio on your Mac to post pictures to Instagram. Until then, save the image and post it from Instagram.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Promo Studio auf deinem Mac, um Bilder auf Instagram zu posten. Bis dahin sichere das Bild und poste es in Instagram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Promo Studio en tu Mac para publicar imágenes en Instagram. Mientras tanto, guarda la imagen y publícala desde Instagram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour Promo Studio sur votre Mac pour publier des images sur Instagram. En attendant, enregistrez l’image et publiez-la depuis Instagram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna Promo Studio sul Mac per pubblicare immagini su Instagram. Nel frattempo, salva l’immagine e pubblicala da Instagram."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagramに画像を投稿するには、MacのPromo Studioをアップデートしてください。それまでは画像を保存してInstagramから投稿してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram에 이미지를 게시하려면 Mac의 Promo Studio를 업데이트하세요. 그 전까지는 이미지를 저장해 Instagram에서 게시하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o Promo Studio no seu Mac para publicar imagens no Instagram. Até lá, salve a imagem e publique pelo Instagram."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram'a resim paylaşmak için Mac'teki Promo Studio'yu güncelleyin. O zamana kadar görseli kaydedip Instagram'dan paylaşın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Mac 上更新 Promo Studio 以将图片发布到 Instagram。在此之前,请保存图片并从 Instagram 发布。"
          }
        }
      }
    },
    "Update Promo Studio on your Mac to see its status here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Promo Studio auf deinem Mac, um seinen Status hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Promo Studio en tu Mac para ver su estado aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour Promo Studio sur votre Mac pour voir son état ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna Promo Studio sul Mac per vederne lo stato qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに状態を表示するには、Mac の Promo Studio をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 상태를 보려면 Mac의 Promo Studio를 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o Promo Studio no seu Mac para ver o status aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durumunu burada görmek için Mac'inizdeki Promo Studio'yu güncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 Mac 上的 Promo Studio 以在此查看其状态。"
          }
        }
      }
    },
