    "To allow everything in a chat without asking, turn on “Bypass permissions” in Remote Code settings on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um in einem Chat alles ohne Nachfrage zu erlauben, aktiviere „Berechtigungen umgehen“ in den Remote-Code-Einstellungen auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para permitir todo en un chat sin preguntar, activa “Omitir permisos” en los ajustes de Remote Code en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour tout autoriser dans une discussion sans confirmation, activez « Ignorer les autorisations » dans les réglages de Remote Code sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per consentire tutto in una chat senza chiedere, attiva “Ignora permessi” nelle impostazioni di Remote Code sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットで確認なしにすべてを許可するには、MacのRemote Code設定で「権限をバイパス」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 묻지 않고 모두 허용하려면 Mac의 Remote Code 설정에서 ‘권한 우회’를 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para permitir tudo em uma conversa sem perguntar, ative “Ignorar permissões” nos ajustes do Remote Code no seu Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sohbette sormadan her şeye izin vermek için Mac'teki Remote Code ayarlarında “İzinleri atla”yı açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在聊天中无需询问即允许所有操作，请在 Mac 上的 Remote Code 设置中打开“绕过权限”。"
          }
        }
      }
    },
    "To post automatically, choose an Instagram account or a project with one.": {
      "localizations": {
