    "Helper processes are counted with their app. Swipe left on an app to quit it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfsprozesse werden ihrer App zugerechnet. Wische auf einer App nach links, um sie zu beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los procesos auxiliares se cuentan con su app. Desliza a la izquierda sobre una app para cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les processus auxiliaires sont comptés avec leur app. Balayez une app vers la gauche pour la quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I processi di supporto sono conteggiati con la loro app. Scorri a sinistra su un’app per chiuderla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパープロセスはそのアプリに含めて表示されます。アプリを左にスワイプすると終了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도우미 프로세스는 해당 앱에 포함됩니다. 앱을 왼쪽으로 쓸어 종료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Processos auxiliares são contados com seu app. Deslize um app para a esquerda para encerrá-lo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı işlemler kendi uygulamalarıyla birlikte sayılır. Bir uygulamayı kapatmak için sola kaydırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助进程计入其所属 App。在 App 上向左轻扫即可退出。"
          }
        }
      }
    },
