          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac está resumindo a semana…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz haftayı özetliyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 正在总结本周…"
          }
        }
      }
    },
    "Your Mac may slow down. %@ uses the most (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac könnte langsamer werden. %@ belegt am meisten (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac puede ir más lento. %@ es la que más usa (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac pourrait ralentir. %@ en utilise le plus (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac potrebbe rallentare. %@ ne usa di più (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の動作が遅くなる可能性があります。最も多く使っているのは %@（%@）です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 느려질 수 있습니다. %@이(가) 가장 많이 사용 중입니다(%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac pode ficar lento. %@ é o que mais usa (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz yavaşlayabilir. En çok %@ kullanıyor (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 可能会变慢。%@ 占用最多（%@）。"
          }
        }
      }
    },
    "Your Mac needs attention": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac braucht Aufmerksamkeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac necesita atención"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac requiert votre attention"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac richiede attenzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に対応が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 확인이 필요합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac precisa de atenção"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz ilgi bekliyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 需要处理"
          }
        }
      }
    },
    "Your coding agents run on your Mac. Remote Code lets you talk to them, follow every step and approve changes from your iPhone or iPad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Coding-Agenten laufen auf deinem Mac. Mit Remote Code sprichst du von deinem iPhone oder iPad aus mit ihnen, verfolgst jeden Schritt und bestätigst Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus agentes de programación se ejecutan en tu Mac. Remote Code te permite hablar con ellos, seguir cada paso y aprobar cambios desde tu iPhone o iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos agents de programmation s’exécutent sur votre Mac. Remote Code vous permet de leur parler, de suivre chaque étape et d’approuver les modifications depuis votre iPhone ou iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi agenti di programmazione vengono eseguiti sul tuo Mac. Remote Code ti permette di parlare con loro, seguire ogni passaggio e approvare le modifiche dal tuo iPhone o iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェントはMac上で動作します。Remote Codeを使えば、iPhoneやiPadからエージェントと会話し、各ステップを確認して、変更を承認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트는 Mac에서 실행됩니다. Remote Code를 사용하면 iPhone 또는 iPad에서 에이전트와 대화하고, 모든 단계를 확인하며, 변경 사항을 승인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus agentes de programação são executados no seu Mac. O Remote Code permite conversar com eles, acompanhar cada etapa e aprovar alterações pelo seu iPhone ou iPad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodlama ajanlarınız Mac'inizde çalışır. Remote Code, iPhone veya iPad'inizden onlarla konuşmanızı, her adımı izlemenizi ve değişiklikleri onaylamanızı sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的编程代理在 Mac 上运行。借助 Remote Code，你可以在 iPhone 或 iPad 上与它们对话、跟进每一步并批准更改。"
          }
        }
      }
    },
    "Your traffic stays end-to-end encrypted by Remote Code in addition to Tailscale's own encryption.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Datenverkehr bleibt zusätzlich zur Verschlüsselung von Tailscale durch Remote Code Ende-zu-Ende verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote Code mantiene tu tráfico cifrado de extremo a extremo, además del propio cifrado de Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre trafic reste chiffré de bout en bout par Remote Code, en plus du chiffrement propre à Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo traffico resta crittografato end-to-end da Remote Code, oltre alla crittografia di Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信はTailscale自体の暗号化に加えて、Remote Codeによるエンドツーエンド暗号化で保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트래픽은 Tailscale 자체 암호화에 더해 Remote Code에 의해 종단 간 암호화된 상태로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu tráfego continua com criptografia de ponta a ponta do Remote Code, além da própria criptografia do Tailscale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafiğiniz, Tailscale'in kendi şifrelemesine ek olarak Remote Code tarafından uçtan uca şifreli kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除了 Tailscale 自身的加密外，你的流量还由 Remote Code 进行端到端加密。"
          }
        }
      }
    },
    "[Video, %@: the %lld images attached are frames from it, evenly spaced from start to end.]": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[Video, %@: Die %lld angehängten Bilder sind Einzelbilder daraus, gleichmäßig vom Anfang bis zum Ende verteilt.]"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[Vídeo, %@: las %lld imágenes adjuntas son fotogramas del vídeo, repartidos de forma uniforme del principio al final.]"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Vidéo, %@ : les %lld images jointes en sont des extraits, répartis uniformément du début à la fin.]"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[Video, %@: le %lld immagini allegate sono fotogrammi tratti dal video, distribuiti uniformemente dall’inizio alla fine.]"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "［ビデオ、%@：添付された%lld枚の画像は、このビデオの最初から最後まで均等な間隔で抽出したフレームです。］"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[비디오, %@: 첨부된 이미지 %lld개는 처음부터 끝까지 균등한 간격으로 추출한 프레임입니다.]"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "[Vídeo, %@: as %lld imagens anexadas são quadros dele, distribuídos uniformemente do início ao fim.]"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[Video, %@: ekteki %lld görsel, bu videodan baştan sona eşit aralıklarla alınmış karelerdir.]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[视频，%@：附带的 %lld 张图像是从中提取的帧，从开头到结尾均匀分布。]"
          }
        }
      }
    },
    "e.g. A wordless video where colored marbles race down a spiral track; the winner’s color is a guess for the comments.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Ein Video ohne Worte, in dem bunte Murmeln eine Spiralbahn hinabrasen; die Siegerfarbe wird in den Kommentaren geraten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. Un vídeo sin palabras donde canicas de colores corren por una pista en espiral; el color ganador se adivina en los comentarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. Une vidéo sans paroles où des billes colorées dévalent une piste en spirale ; la couleur gagnante se devine en commentaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Un video senza parole in cui biglie colorate corrono lungo una pista a spirale; il colore vincente si indovina nei commenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：色とりどりのビー玉がらせんコースを競走する、言葉のない動画。勝つ色をコメントで予想してもらう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 색색의 구슬이 나선형 트랙을 달리는 무언 동영상. 우승 색을 댓글로 맞히게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: Um vídeo sem falas em que bolinhas coloridas correm por uma pista em espiral; a cor vencedora é palpite nos comentários."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ör. Renkli bilyelerin spiral bir pistte yarıştığı sözsüz bir video; kazanan renk yorumlarda tahmin edilsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：一段无旁白的视频，彩色弹珠沿螺旋轨道竞速；让观众在评论里猜获胜的颜色。"
          }
        }
      }
    },
    "e.g. Make the hook bolder and mention it is free in the last scene": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Mach den Einstieg kühner und erwähne in der letzten Szene, dass es kostenlos ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. Haz el gancho más atrevido y menciona en la última escena que es gratis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. Rends l’accroche plus audacieuse et mentionne dans la dernière scène que c’est gratuit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Rendi l’attacco più audace e menziona nell’ultima scena che è gratis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：冒頭をもっと大胆にして、最後のシーンで無料だと伝えて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 도입부를 더 과감하게 하고 마지막 장면에서 무료라고 언급해 줘"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: Deixe o gancho mais ousado e diga na última cena que é grátis"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ör. Kancayı daha iddialı yap ve son sahnede ücretsiz olduğunu belirt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：让开头更大胆，并在最后一个场景提到它是免费的"
          }
        }
      }
    },
    "e.g. The derby is tonight. Make an energetic promo with a countdown and the AI prediction.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Das Derby ist heute Abend. Mach einen energiegeladenen Promo-Clip mit Countdown und KI-Prognose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. El derbi es esta noche. Haz un promo enérgico con cuenta atrás y la predicción de la IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. Le derby a lieu ce soir. Fais une promo énergique avec un compte à rebours et la prédiction de l’IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Il derby è stasera. Crea un promo energico con conto alla rovescia e la previsione dell’IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：ダービーは今夜。カウントダウンとAI予想を入れた勢いのあるプロモ動画を作って。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 더비가 오늘 밤이야. 카운트다운과 AI 예측이 들어간 에너지 넘치는 홍보 영상을 만들어 줘."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: O clássico é hoje à noite. Faça um promo energético com contagem regressiva e a previsão da IA."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ör. Derbi bu akşam. Geri sayım ve yapay zekâ tahmini olan enerjik bir tanıtım videosu yap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：德比今晚开赛。制作一个带倒计时和 AI 预测的动感宣传片。"
          }
        }
      }
    },
    "e.g. Tonight’s derby in 20 seconds: the key stats, the lineups and a prediction.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Das Derby heute Abend in 20 Sekunden: die wichtigsten Zahlen, die Aufstellungen und ein Tipp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej. El derbi de esta noche en 20 segundos: las estadísticas clave, las alineaciones y un pronóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. Le derby de ce soir en 20 secondes : les stats clés, les compositions et un pronostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. Il derby di stasera in 20 secondi: le statistiche chiave, le formazioni e un pronostico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：今夜のダービーを20秒で。主なスタッツ、スタメン、予想。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 오늘 밤 더비를 20초로: 핵심 통계, 라인업, 예측."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: O clássico de hoje à noite em 20 segundos: as estatísticas principais, as escalações e um palpite."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ör. Bu akşamki derbi 20 saniyede: önemli istatistikler, kadrolar ve bir tahmin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：20 秒看懂今晚的德比：关键数据、首发阵容和一个预测。"
          }
        }
      }
    },
    "iOS does not let apps install or configure a VPN for you, so step 2 has to be done by hand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS erlaubt Apps nicht, ein VPN für dich zu installieren oder zu konfigurieren, daher musst du Schritt 2 selbst ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no permite que las apps instalen o configuren una VPN por ti, así que el paso 2 tienes que hacerlo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne permet pas aux apps d’installer ou de configurer un VPN à votre place : l’étape 2 doit donc être faite manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non consente alle app di installare o configurare una VPN per te, quindi il passaggio 2 va fatto a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSではアプリがVPNをインストールしたり構成したりできないため、手順2は手動で行う必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서는 앱이 VPN을 대신 설치하거나 구성할 수 없으므로 2단계는 직접 수행해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não permite que os apps instalem ou configurem uma VPN para você; por isso, a etapa 2 precisa ser feita manualmente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, uygulamaların sizin için VPN kurmasına veya yapılandırmasına izin vermez; bu yüzden 2. adım elle yapılmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许 App 替你安装或配置 VPN，因此第 2 步需要手动完成。"
          }
        }
      }
    },
